{"command": "foobar123", "exit_code": 127, "stderr": "foobar123: command not found", "expected_category": "command_not_found", "description": "Nonexistent command"}
{"command": "cat /etc/shadow", "exit_code": 1, "stderr": "cat: /etc/shadow: Permission denied", "expected_category": "permission_denied", "description": "Permission denied on shadow file"}
{"command": "cat /nonexistent", "exit_code": 1, "stderr": "cat: /nonexistent: No such file or directory", "expected_category": "file_not_found", "description": "File does not exist"}
{"command": "ls /not/a/directory", "exit_code": 2, "stderr": "ls: cannot access '/not/a/directory': No such file or directory", "expected_category": "file_not_found", "description": "Directory does not exist"}
{"command": "bash -c 'if then fi'", "exit_code": 2, "stderr": "bash: -c: line 1: syntax error near unexpected token `then'", "expected_category": "syntax_error", "description": "Bash syntax error"}
{"command": "ls --invalid-option-xyz", "exit_code": 2, "stderr": "ls: unrecognized option '--invalid-option-xyz'", "expected_category": "argument_error", "description": "Invalid command option"}
{"command": "apt install nonexistent-package-xyz", "exit_code": 100, "stderr": "E: Unable to locate package nonexistent-package-xyz", "expected_category": "dependency_missing", "description": "Package not found"}
{"command": "dd if=/dev/zero of=/dev/full bs=1M count=1", "exit_code": 1, "stderr": "dd: error writing '/dev/full': No space left on device", "expected_category": "resource_exhausted", "description": "Disk full"}
{"command": "curl http://192.0.2.1", "exit_code": 7, "stderr": "curl: (7) Failed to connect to 192.0.2.1 port 80: Connection refused", "expected_category": "network_error", "description": "Connection refused"}
{"command": "ping -c 1 invalid.domain.xyz", "exit_code": 2, "stderr": "ping: invalid.domain.xyz: Name or service not known", "expected_category": "network_error", "description": "DNS resolution failure"}
{"command": "systemctl restart nonexistent-service", "exit_code": 5, "stderr": "Failed to restart nonexistent-service.service: Unit nonexistent-service.service not found.", "expected_category": "command_not_found", "description": "Service not found"}
{"command": "grep -r pattern", "exit_code": 1, "stderr": "", "expected_category": "other", "description": "No match found (not an error)"}
{"command": "python3 script.py", "exit_code": 1, "stderr": "python3: can't open file 'script.py': [Errno 2] No such file or directory", "expected_category": "file_not_found", "description": "Python script not found"}
{"command": "apt-get update", "exit_code": 100, "stderr": "E: Could not get lock /var/lib/dpkg/lock-frontend - open (13: Permission denied)", "expected_category": "permission_denied", "description": "apt lock permission denied"}
{"command": "docker ps", "exit_code": 1, "stderr": "Got permission denied while trying to connect to the Docker daemon socket", "expected_category": "permission_denied", "description": "Docker permission denied"}
{"command": "ssh user@host", "exit_code": 255, "stderr": "ssh: connect to host host port 22: Connection timed out", "expected_category": "network_error", "description": "SSH connection timeout"}
{"command": "npm install", "exit_code": 1, "stderr": "npm ERR! code ENOENT\nnpm ERR! syscall open\nnpm ERR! path /home/user/package.json", "expected_category": "file_not_found", "description": "npm package.json not found"}
{"command": "git push origin main", "exit_code": 128, "stderr": "fatal: Authentication failed for 'https://github.com/...'", "expected_category": "permission_denied", "description": "Git authentication failed"}
{"command": "mysql -u root -p", "exit_code": 1, "stderr": "ERROR 1045 (28000): Access denied for user 'root'@'localhost'", "expected_category": "permission_denied", "description": "MySQL access denied"}
{"command": "tar xf file.tar.gz", "exit_code": 2, "stderr": "tar: file.tar.gz: Cannot open: No such file or directory", "expected_category": "file_not_found", "description": "Tar file not found"}
