[Unit]
Description=ELLE Daemon - Local System Intelligence
Documentation=https://github.com/elle/elle
After=network.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/elled
Restart=on-failure
RestartSec=5

# User and group
User=elle
Group=elle

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Read-only access to system
ReadOnlyPaths=/etc /usr /boot

# Write access for state
ReadWritePaths=/var/lib/elle

# Capabilities for eBPF telemetry
# CAP_BPF: Load/unload BPF programs, create maps (kernel 5.8+)
# CAP_PERFMON: Attach to tracepoints and perf events (kernel 5.8+)
# CAP_NET_ADMIN: Network namespace access for net probes (optional)
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN

# Allow access to /sys/fs/bpf for BPF filesystem
ProtectKernelLogs=false

# Environment
Environment=ELLE_LOG_LEVEL=INFO
EnvironmentFile=-/etc/elle/environment

# Resource limits
MemoryMax=512M
CPUWeight=50

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=elled

[Install]
WantedBy=multi-user.target
