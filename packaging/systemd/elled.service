[Unit]
Description=ELLE Daemon - Local System Intelligence
Documentation=https://github.com/araujota/elle
After=network.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/elled
Restart=on-failure
RestartSec=5

# Run as root for full system access (eBPF, journal, Polkit)
# Security is enforced via capabilities and policy engine, not user isolation

# Security hardening (still applied even as root)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=false
ProtectKernelLogs=false

# Environment
Environment=ELLE_LOG_LEVEL=INFO
EnvironmentFile=-/etc/elle/environment

# Resource limits
MemoryMax=512M
CPUWeight=50

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=elled

[Install]
WantedBy=multi-user.target
