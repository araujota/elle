#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop and disable the daemon before removing files
        if [ -d /run/systemd/system ]; then
            # Stop the service if running
            systemctl stop elled.service 2>/dev/null || true
            # Disable the service
            systemctl disable elled.service 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
