#!/bin/sh
set -e

case "$1" in
    configure)
        # Step 1: Install Python dependencies that require newer versions than apt provides
        # Ubuntu's python3-pydantic is v1.x but we need v2.x
        if command -v pip3 >/dev/null 2>&1; then
            pip3 install --quiet --break-system-packages "pydantic>=2.0" 2>/dev/null || \
            pip3 install --quiet "pydantic>=2.0" 2>/dev/null || true
        fi

        # Step 2: Create required directories with proper permissions
        # All directories owned by root since daemon runs as root
        install -d -m 0755 /var/lib/elle
        install -d -m 0755 /var/lib/elle/backups
        install -d -m 0755 /var/lib/elle/mobile
        install -d -m 0755 /var/cache/elle
        install -d -m 0755 /var/log/elle
        install -d -m 0755 /var/run/elle
        install -d -m 0755 /etc/elle

        # Step 3: Install example config if none exists
        if [ ! -f /etc/elle/elle.toml ]; then
            if [ -f /usr/share/elle/elle.toml.example ]; then
                install -m 0644 /usr/share/elle/elle.toml.example /etc/elle/elle.toml
            fi
        fi

        # Step 4: Reload systemd and enable daemons
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable elled.service

            # Enable unified telemetry daemon if available (preferred)
            if [ -f /lib/systemd/system/elled-telemetryd.service ]; then
                systemctl enable elled-telemetryd.service
                # Disable legacy daemons if present
                if [ -f /lib/systemd/system/elled-ebpfd.service ]; then
                    systemctl disable elled-ebpfd.service 2>/dev/null || true
                fi
                if [ -f /lib/systemd/system/elled-probed.service ]; then
                    systemctl disable elled-probed.service 2>/dev/null || true
                fi
            else
                # Fall back to legacy daemons if telemetryd not installed
                if [ -f /lib/systemd/system/elled-ebpfd.service ]; then
                    systemctl enable elled-ebpfd.service
                fi
                if [ -f /lib/systemd/system/elled-probed.service ]; then
                    systemctl enable elled-probed.service
                fi
            fi

            # Don't auto-start - user needs to configure Ollama first
            echo "ELLE installed. Configure Ollama, then run: systemctl start elled"
        fi
        ;;
esac

#DEBHELPER#

exit 0
