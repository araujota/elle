#!/bin/sh
set -e

case "$1" in
    configure)
        # Install Python dependencies that require newer versions than apt provides
        # Ubuntu's python3-pydantic is v1.x but we need v2.x
        if command -v pip3 >/dev/null 2>&1; then
            pip3 install --quiet --break-system-packages "pydantic>=2.0" 2>/dev/null || \
            pip3 install --quiet "pydantic>=2.0" 2>/dev/null || true
        fi

        # Create required directories first (before user, to avoid adduser warning)
        install -d -m 0750 /var/lib/elle
        install -d -m 0750 /var/lib/elle/backups
        install -d -m 0755 /etc/elle

        # Create elle system user if it doesn't exist
        if ! getent passwd elle >/dev/null 2>&1; then
            adduser --system --group --home /var/lib/elle \
                    --no-create-home --shell /usr/sbin/nologin \
                    --gecos "ELLE System Agent" elle
        fi

        # Set ownership of directories to elle user
        chown -R elle:elle /var/lib/elle

        # Install example config if none exists
        if [ ! -f /etc/elle/elle.toml ]; then
            if [ -f /usr/share/elle/elle.toml.example ]; then
                install -m 0644 /usr/share/elle/elle.toml.example /etc/elle/elle.toml
            fi
        fi

        # Enable and start daemon
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable elled.service
            # Don't auto-start - user needs to configure Ollama first
            echo "ELLE installed. Configure Ollama, then run: systemctl start elled"
        fi
        ;;
esac

#DEBHELPER#

exit 0
